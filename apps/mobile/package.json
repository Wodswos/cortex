{
  "name": "@cortex/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "pnpm --filter @cortex/web build --mode mobile",
    "sync": "pnpm build:web && rm -rf www && cp -r ../web/dist www && cap sync && node scripts/configure-ios.mjs",
    "add:ios": "cap add ios",
    "open:ios": "cap open ios",
    "dev": "cap run ios",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
